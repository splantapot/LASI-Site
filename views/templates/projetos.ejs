<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LASI - Projetos</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&display=swap" rel="stylesheet">
    
    <link class="reldoc" rel="stylesheet" href="./css/style.css">
    <link class="reldoc" rel="stylesheet" href="./css/layout-components.css">
    <link class="reldoc" rel="stylesheet" href="./css/slider-box.css">
    <link class="reldoc" rel="stylesheet" href="./css/project-tree.css">

</head>
<body>
    <!-- <pcb-background color="var(--pcb-color-blue)"></pcb-background> -->
    <pcb-background color="var(--pcb-color-cyan)"></pcb-background>

    <navigation-bar></navigation-bar>

    <main>
        <project-tree title="Nossos Projetos" footer="...">

        <% if (typeof projetos !== 'undefined' && projetos && projetos.length > 0) { %>
            <% projetos.forEach(function(projeto) { %>
                <project-branch
                    title="<%= projeto.titulo %>"
                    date="<%= projeto.data %>"
                    
                    <% Object.keys(projeto.media || {}).forEach(function(media) { %>
                        <%= media %>='<%= projeto.media[media] %>'
                    <% }); %>

                    text="<%= projeto.texto %>"

                    <% let i = 1; while (projeto['img' + i] !== undefined) { %>
                        img<%= i %>="<%= projeto['img' + i] %>"
                    <% i++; } %>
                ></project-branch>
            <% }); %>
        <% } %>
        
        </project-tree>
    </main>

    <footer-bar></footer-bar>

    <script src="./js/global.js"></script>
    <script src="./js/layout-components.js"></script>
    <script src="./js/pcb-background.js"></script>
    <script src="./js/project-tree.js"></script>
    <script src="./js/slider-box.js"></script>
</body>
</html>