<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Bem-vindo ao LASI. Conheça nossos projetos, pesquisas e novidades.">
    <title>LASI - Início</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&display=swap" rel="stylesheet">
    <!-- Styles -->
    <link rel="stylesheet" href="./css/style.css">
    <link rel="stylesheet" href="./css/index.css">
    <link rel="stylesheet" href="./css/layout-components.css">
    <link rel="stylesheet" href="./css/slider-box.css">
    <link rel="stylesheet" href="./css/card-box.css">
    
</head>
<body>
    <!-- todo: add intro -->

    <navigation-bar></navigation-bar>
    
    <main>
        <% if (typeof apresentacoes !== 'undefined' && apresentacoes && apresentacoes.length > 0) { %>
            <section class="section__slideshow-box">
                <slider-box>
                    <% apresentacoes.forEach(function(apresentacao) { %>
                        <slider-item
                            <% if (apresentacao.titulo) { %> title="<%= apresentacao.titulo %>" <% } %>
                            <% if (apresentacao.texto) { %> text="<%= apresentacao.texto %>" <% } %>
                            <% if (apresentacao.link_texto) { %> link-text="<%= apresentacao.link_texto %>" <% } %>
                            <% if (apresentacao.link_url) { %> link-url="<%= apresentacao.link_url %>" <% } %>
                            <% if (apresentacao.foto) { %> img="<%= apresentacao.foto %>" <% } %>
                        ></slider-item>
                    <% }); %>
                </slider-box>
            </section>
        <% } %>

        <section class="section__about" id="about">
            <card-box title="Sobre Nós" subtitle="Conheça a essência e os objetivos do LASI">
                <card-item
                    img="./assets/info/logo-lasi.png"
                    title="Missão" 
                    text="Desenvolver pesquisas de ponta e soluções tecnológicas inovadoras, promovendo a integração entre a academia e o ecossistema digital."
                ></card-item>

                <card-item 
                    img="./assets/info/home.svg"
                    title="Visão" 
                    text="Ser referência nacional e internacional em inovação tecnológica, reconhecido pela excelência em projetos de impacto social e científico."
                ></card-item>

                <card-item 
                    title="Valores" 
                    text="Ética na pesquisa, colaboração interdisciplinar, transparência nos resultados e compromisso contínuo com a evolução tecnológica."
                ></card-item>

                <card-item 
                    title="Inovação" 
                    text="Fomentar a criação de metodologias disruptivas e ferramentas avançadas que antecipem as demandas do mercado e da sociedade."
                ></card-item>

                <card-item 
                    title="Impacto" 
                    text="Transformar conhecimento acadêmico em soluções práticas que gerem valor real, desenvolvimento sustentável e melhoria na qualidade de vida."
                ></card-item>
            </card-box>
        </section>

        <section class="section__infos">
            <h2 class="section__infos-title">Um pouco mais...</h2>
            <div class="section__grid-container">
                <div class="section__grid-item A">
                    <a href="/projetos">Conheça nossos projetos</a>
                </div>
                <div class="section__grid-item B">
                    <a href="/quizes">Que tal um quiz? Confira!</a>
                </div>
                <div class="section__grid-item C">
                    <a href="/noticias">Mantenha-se informado</a>
                </div>
                <div class="section__grid-item D">
                    <a href="/acervo">Explore nosso acervo</a>
                </div>
            </div>
        </section>

        <section class="section__media" id="media">
            <card-box title="Acompanhe nossas redes sociais" row>
                <card-item
                    media="instagram"
                    media-url="https://instagram.com/lasi.ufpi"
                ></card-item>

                <card-item
                    media="github"
                    media-url="https://github.com/LASI-UFPI"
                ></card-item>

                <card-item
                    media="youtube"
                    media-url="https://youtube.com/@lasi-4908"
                ></card-item>
            </card-box>
        </section>

        <% if (typeof patrocinadores !== 'undefined' && patrocinadores && patrocinadores.length > 0) { %>
            <section class="section__sponsors">
                <card-box title="Apoio" row>
                    <% patrocinadores.forEach(function(patrocinador) { %>
                        <card-item
                        <% if (patrocinador.logo) { %> logo="<%= patrocinador.logo %>" <% } %>
                        <% if (patrocinador.link) { %> logo-url="<%= patrocinador.link %>" <% } %>
                        <% if (patrocinador.formato) { %> <%= patrocinador.formato %> <% } %>
                        ></card-item>
                    <% }); %>
                </card-box>
            </section>
        <% } %>

    </main>

    <footer-bar></footer-bar>

    <script src="./js/global.js"></script>
    <script src="./js/layout-components.js"></script>
    <script src="./js/slider-box.js"></script>
    <script src="./js/card-box.js"></script>
</body>
</html>